[Unit]
Description=CivicLenZ HERMES ingress Tunnel
Wants=network-online.target
After=network-online.target
ConditionPathExists=/etc/civiclenz/cloudflared-ingest.token

[Service]
Type=simple
User=civiclenz
Group=civiclenz
ExecStart=/usr/local/bin/cloudflared tunnel --no-autoupdate --metrics 127.0.0.1:20241 run --token-file /etc/civiclenz/cloudflared-ingest.token
Restart=on-failure
RestartSec=5s
NoNewPrivileges=yes
PrivateTmp=yes
ProtectHome=yes
ProtectSystem=strict
UMask=0077

[Install]
WantedBy=multi-user.target
