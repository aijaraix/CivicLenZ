#!/usr/bin/env bash
#
# Securely install the CivicLenZ HERMES <-> Harvester shared secret.
#
# This tool never generates, prints, logs, or transmits the secret. It only
# writes a validated operator-supplied value to the local service environment.

set -euo pipefail

readonly SECRET_DIR="/etc/civiclenz"
readonly SECRET_FILE="${SECRET_DIR}/harvester-bridge.env"
readonly RUNTIME_GROUP="civiclenz"

usage() {
  printf '%s\n' "Usage: $(basename "$0") [--verify-stored]" >&2
}

if [[ "${EUID}" -ne 0 ]]; then
  printf '%s\n' "Run this tool with sudo." >&2
  exit 1
fi

if [[ $# -gt 1 || ( $# -eq 1 && "$1" != "--verify-stored" ) ]]; then
  usage
  exit 2
fi

validate_secret() {
  local value="$1"
  local classes=0

  [[ ${#value} -ge 32 && ${#value} -le 512 ]] || return 1
  [[ "$value" != *[[:space:]]* ]] || return 1
  [[ "$value" =~ [[:lower:]] ]] && ((classes += 1))
  [[ "$value" =~ [[:upper:]] ]] && ((classes += 1))
  [[ "$value" =~ [[:digit:]] ]] && ((classes += 1))
  [[ "$value" =~ [^[:alnum:]] ]] && ((classes += 1))
  [[ ${classes} -ge 3 ]] || return 1
  [[ ! "$value" =~ ^(.)\1+$ ]] || return 1
}

verify_file() {
  local file="$1"
  local owner mode value
  [[ -f "$file" && -r "$file" ]] || return 1
  owner="$(stat -c '%U:%G' "$file")"
  mode="$(stat -c '%a' "$file")"
  [[ "$owner" == "root:${RUNTIME_GROUP}" && "$mode" == "640" ]] || return 1
  # The file is root-owned, only this tool creates it, and it contains a
  # shell-safe assignment created with printf %q below.
  # shellcheck source=/dev/null
  source "$file"
  value="${CIVICLENZ_HARVESTER_SHARED_SECRET:-}"
  validate_secret "$value"
}

if [[ "${1:-}" == "--verify-stored" ]]; then
  if verify_file "$SECRET_FILE"; then
    unset CIVICLENZ_HARVESTER_SHARED_SECRET
    printf '%s\n' "CivicLenZ Harvester bridge secret is stored securely."
    exit 0
  fi
  unset CIVICLENZ_HARVESTER_SHARED_SECRET
  printf '%s\n' "No valid CivicLenZ Harvester bridge secret is stored." >&2
  exit 1
fi

install -d -o root -g "${RUNTIME_GROUP}" -m 0750 "${SECRET_DIR}"

read -r -s -p "CivicLenZ Harvester shared secret: " bridge_secret
printf '\n'
read -r -s -p "Confirm CivicLenZ Harvester shared secret: " bridge_secret_confirmation
printf '\n'

if [[ "$bridge_secret" != "$bridge_secret_confirmation" ]]; then
  unset bridge_secret bridge_secret_confirmation
  printf '%s\n' "The secret entries did not match. The existing stored credential was left unchanged." >&2
  exit 1
fi

if ! validate_secret "$bridge_secret"; then
  unset bridge_secret bridge_secret_confirmation
  printf '%s\n' "The shared secret must be 32–512 non-whitespace characters from at least three character classes. The existing stored credential was left unchanged." >&2
  exit 1
fi

umask 077
tmp_file="$(mktemp "${SECRET_DIR}/.harvester-bridge.XXXXXX")"
trap 'rm -f -- "${tmp_file}"' EXIT

printf '%s\n' "# Managed by civiclenz-set-harvester-bridge-secret. Do not commit, copy, or print." > "$tmp_file"
printf 'CIVICLENZ_HARVESTER_SHARED_SECRET=%q\n' "$bridge_secret" >> "$tmp_file"
chown root:"${RUNTIME_GROUP}" "$tmp_file"
chmod 0640 "$tmp_file"

if ! verify_file "$tmp_file"; then
  unset bridge_secret bridge_secret_confirmation CIVICLENZ_HARVESTER_SHARED_SECRET
  printf '%s\n' "The bridge secret could not be validated. The existing stored credential was left unchanged." >&2
  exit 1
fi

mv -f "$tmp_file" "$SECRET_FILE"
trap - EXIT
unset bridge_secret bridge_secret_confirmation CIVICLENZ_HARVESTER_SHARED_SECRET
printf '%s\n' "CivicLenZ Harvester bridge secret saved securely."
