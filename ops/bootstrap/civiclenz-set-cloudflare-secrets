#!/usr/bin/env bash
#
# Securely install CivicLenZ Cloudflare account-owned API credentials.
#
# This helper is intentionally limited to Cloudflare account API tokens
# (`cfat_...`). It never writes a candidate credential until Cloudflare has
# accepted it through the account-token verification endpoint and a
# CivicLenZ-required account-scoped resource probe.

set -euo pipefail

readonly SECRET_DIR="/etc/civiclenz"
readonly SECRET_FILE="${SECRET_DIR}/secrets.env"
readonly RUNTIME_USER="civiclenz"
readonly RUNTIME_GROUP="civiclenz"
readonly CLOUDFLARE_API_BASE="https://api.cloudflare.com/client/v4"

usage() {
  printf '%s\n' "Usage: $(basename "$0") [--verify-stored]" >&2
}

if [[ "${EUID}" -ne 0 ]]; then
  printf '%s\n' "Run this tool with sudo." >&2
  exit 1
fi

if [[ $# -gt 1 ]]; then
  usage
  exit 2
fi

if [[ $# -eq 1 && "$1" != "--verify-stored" ]]; then
  usage
  exit 2
fi

validate_account_id() {
  [[ "$1" =~ ^[A-Fa-f0-9]{32}$ ]]
}

validate_account_token() {
  # CivicLenZ deliberately uses durable account-owned Cloudflare API tokens.
  # Cloudflare's current scannable account-token format begins with cfat_.
  [[ -n "$1" && "$1" != *[[:space:]]* && "$1" == cfat_* ]]
}

verify_credential_file() {
  local candidate_file="$1"

  sudo -u "${RUNTIME_USER}" bash -s -- "${candidate_file}" "${CLOUDFLARE_API_BASE}" <<'VERIFY_INNER'
set -euo pipefail

candidate_file="$1"
cloudflare_api_base="$2"
export CIVICLENZ_CLOUDFLARE_API_BASE="${cloudflare_api_base}"

set -a
# The file is root-owned and writable only by root. It was created with
# shell-safe values by this helper before this process reads it.
# shellcheck source=/dev/null
. "${candidate_file}"
set +a

exec python3 - <<'PY'
import json
import os
import sys
from urllib.error import HTTPError, URLError
from urllib.request import ProxyHandler, Request, build_opener

api = os.environ["CIVICLENZ_CLOUDFLARE_API_BASE"]
token = os.environ["CLOUDFLARE_API_TOKEN"]
account_id = os.environ["CLOUDFLARE_ACCOUNT_ID"]

headers = {
    "Authorization": "Bearer " + token,
    "Accept": "application/json",
    "User-Agent": "CivicLenZ-Account-Token-Verification/1.0",
}

def request_json(path):
    request = Request(api + path, headers=headers, method="GET")
    # Avoid a proxy injecting or rewriting authentication headers.
    with build_opener(ProxyHandler({})).open(request, timeout=30) as response:
        return json.loads(response.read().decode("utf-8"))

try:
    # Account-owned Cloudflare API tokens must be verified against the account
    # endpoint. Do not substitute the user-token verification endpoint for
    # cfat_ credentials.
    payload = request_json(f"/accounts/{account_id}/tokens/verify")
    status = (payload.get("result") or {}).get("status")
    if not payload.get("success") or status != "active":
        print("account_token_rejected")
        raise SystemExit

    # The verify endpoint establishes token activity, but Cloudflare does not
    # use it to prove that the supplied account owns the CivicLenZ resources.
    # Require one harmless account-scoped inventory call before replacing a
    # stored credential. Workers Scripts Read is a required CivicLenZ runtime
    # permission, so this protects against an otherwise-valid token paired
    # with the wrong Account ID.
    inventory = request_json(f"/accounts/{account_id}/workers/scripts")
    if inventory.get("success"):
        print("accepted")
    else:
        print("account_resource_scope_or_workers_permission_denied")
except HTTPError as error:
    try:
        payload = json.loads(error.read().decode("utf-8"))
    except Exception:
        payload = {}
    codes = {item.get("code") for item in payload.get("errors", [])}
    if 9109 in codes:
        print("invalid_account_id")
    elif error.code == 401 or 1000 in codes:
        print("invalid_account_token")
    elif error.code == 403 or 10000 in codes:
        print("account_resource_scope_or_workers_permission_denied")
    else:
        print("account_token_rejected")
except URLError:
    print("network_error")
PY
VERIFY_INNER
}

report_verification_result() {
  case "$1" in
    accepted)
      return 0
      ;;
    invalid_account_token)
      printf '%s\n' "Cloudflare rejected the account API token. The existing stored credentials were left unchanged." >&2
      ;;
    invalid_account_id)
      printf '%s\n' "Cloudflare rejected the Account ID. The existing stored credentials were left unchanged." >&2
      ;;
    account_resource_scope_or_workers_permission_denied)
      printf '%s\n' "Cloudflare accepted the token but denied the required CivicLenZ Workers inventory for the supplied Account ID. The existing stored credentials were left unchanged." >&2
      ;;
    network_error)
      printf '%s\n' "Cloudflare could not be reached for verification. The existing stored credentials were left unchanged." >&2
      ;;
    *)
      printf '%s\n' "Cloudflare rejected the account-token verification request. The existing stored credentials were left unchanged." >&2
      ;;
  esac
  return 1
}

if [[ "${1:-}" == "--verify-stored" ]]; then
  if [[ ! -r "${SECRET_FILE}" ]]; then
    printf '%s\n' "No stored CivicLenZ Cloudflare credential file is available." >&2
    exit 1
  fi

  verification_result="$(
    verify_credential_file "${SECRET_FILE}"
  )"

  if report_verification_result "${verification_result}"; then
    printf '%s\n' "CivicLenZ stored Cloudflare account token verified securely."
    exit 0
  fi
  exit 1
fi

read -r -s -p "Cloudflare account API token: " cloudflare_token
printf '\n'
read -r -s -p "Cloudflare account ID: " cloudflare_account_id
printf '\n'

if ! validate_account_token "${cloudflare_token}"; then
  printf '%s\n' "The API token was not accepted. CivicLenZ requires an account-owned Cloudflare API token in the cfat_ format, with no whitespace." >&2
  exit 1
fi

if ! validate_account_id "${cloudflare_account_id}"; then
  printf '%s\n' "The Cloudflare account ID must be exactly 32 hexadecimal characters." >&2
  exit 1
fi

umask 077
tmp_file="$(mktemp "${SECRET_DIR}/.cloudflare-secrets.XXXXXX")"
trap 'rm -f "${tmp_file}"' EXIT

{
  printf '%s\n' "# Managed by civiclenz-set-cloudflare-secrets. Do not commit, copy, or print."
  printf 'CLOUDFLARE_API_TOKEN=%q\n' "${cloudflare_token}"
  printf 'CLOUDFLARE_ACCOUNT_ID=%q\n' "${cloudflare_account_id}"
} > "${tmp_file}"

chown root:"${RUNTIME_GROUP}" "${tmp_file}"
chmod 0640 "${tmp_file}"

verification_result="$(
  verify_credential_file "${tmp_file}"
)"

if ! report_verification_result "${verification_result}"; then
  unset cloudflare_token cloudflare_account_id
  exit 1
fi

mv -f "${tmp_file}" "${SECRET_FILE}"
trap - EXIT
unset cloudflare_token cloudflare_account_id
printf '%s\n' "CivicLenZ Cloudflare account API token verified and saved securely."
