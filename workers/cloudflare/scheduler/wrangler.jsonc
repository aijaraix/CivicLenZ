{
  "name": "civiclenz-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "triggers": {
    "crons": [
      "0 */6 * * *",
      "15 7 * * *"
    ]
  },
  "vars": {
    "DRY_RUN": "true",
    "WORKER_KEY": "civiclenz-scheduler"
  },
  // CIVICLENZ_OPERATOR_TRIGGER_SECRET is a Cloudflare secret via `wrangler secret put`. Never a var.
  "queues": {
    "producers": [
      { "binding": "INGEST_QUEUE", "queue": "civiclenz-ingest" },
      { "binding": "VALIDATE_QUEUE", "queue": "civiclenz-validate" },
      { "binding": "MONITOR_QUEUE", "queue": "civiclenz-monitor" },
      { "binding": "HEAVY_QUEUE", "queue": "civiclenz-heavy" },
      { "binding": "DEAD_LETTER_QUEUE", "queue": "civiclenz-dead-letter" }
    ]
  }
}
