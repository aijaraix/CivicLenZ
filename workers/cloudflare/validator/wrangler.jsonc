{
  "name": "civiclenz-validator",
  "main": "src/index.ts",
  "compatibility_date": "2026-09-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "version_metadata": {
    "binding": "CF_VERSION_METADATA"
  },
  "vars": {
    "WORKER_KEY": "civiclenz-validator"
  },
  "queues": {
    "producers": [
      { "binding": "HEAVY_QUEUE", "queue": "civiclenz-heavy" },
      { "binding": "DEAD_LETTER_QUEUE", "queue": "civiclenz-dead-letter" }
    ],
    "consumers": [
      {
        "queue": "civiclenz-validate",
        "max_batch_size": 10,
        "max_batch_timeout": 15,
        "max_retries": 4,
        "dead_letter_queue": "civiclenz-dead-letter"
      }
    ]
  }
}
