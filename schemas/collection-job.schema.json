{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://civiclenz.ai/schemas/collection-job.schema.json",
  "title": "CivicLenZ bounded collection job manifest",
  "description": "A review-only, source-bounded job contract for collection workers. A manifest identifies exactly one permanent seat or an explicit bounded batch and never authorizes public publication.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "manifestVersion",
    "jobId",
    "identity",
    "source",
    "owner",
    "executionLimits",
    "output",
    "review",
    "dedupeKey"
  ],
  "properties": {
    "manifestVersion": {
      "const": "1.0"
    },
    "jobId": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{2,95}$"
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "jurisdictionId",
        "jurisdictionName",
        "effectiveDate",
        "phase",
        "target"
      ],
      "properties": {
        "jurisdictionId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._:-]{1,159}$"
        },
        "jurisdictionName": {
          "type": "string",
          "minLength": 2,
          "maxLength": 160
        },
        "effectiveDate": {
          "type": "string",
          "format": "date"
        },
        "phase": {
          "type": "string",
          "enum": [
            "source_discovery",
            "seat_registry",
            "identity",
            "portrait",
            "contact",
            "social",
            "biography",
            "legislative_detail",
            "evidence_refresh"
          ]
        },
        "target": {
          "$ref": "#/$defs/target"
        }
      }
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "sourceId",
        "canonicalUrl",
        "host",
        "tier",
        "ratePolicy"
      ],
      "properties": {
        "sourceId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "host": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9.-]{1,251}$"
        },
        "tier": {
          "type": "string",
          "enum": [
            "primary_official",
            "primary_statement",
            "reputable_secondary",
            "specialist_database",
            "discovery_only"
          ]
        },
        "termsUrl": {
          "type": "string",
          "format": "uri",
          "pattern": "^https://"
        },
        "ratePolicy": {
          "$ref": "#/$defs/ratePolicy"
        }
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "workstreamId",
        "workerId"
      ],
      "properties": {
        "workstreamId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"
        },
        "workerId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"
        }
      }
    },
    "executionLimits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "maxRecords",
        "maxRequests",
        "maxRuntimeSeconds",
        "mode"
      ],
      "properties": {
        "maxRecords": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50
        },
        "maxRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500
        },
        "maxRuntimeSeconds": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3600
        },
        "mode": {
          "const": "staging_only"
        }
      }
    },
    "output": {
      "$ref": "#/$defs/output"
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "publicationAllowed",
        "reviewStatus",
        "promotionRequired",
        "humanReviewRequired"
      ],
      "properties": {
        "publicationAllowed": {
          "const": false
        },
        "reviewStatus": {
          "const": "unreviewed"
        },
        "promotionRequired": {
          "const": true
        },
        "humanReviewRequired": {
          "const": true
        }
      }
    },
    "dedupeKey": {
      "type": "string",
      "pattern": "^clzj1-[a-f0-9]{64}$"
    }
  },
  "$defs": {
    "seatKey": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._:-]{2,159}$"
    },
    "target": {
      "oneOf": [
        {
          "$ref": "#/$defs/permanentSeat"
        },
        {
          "$ref": "#/$defs/boundedBatch"
        }
      ]
    },
    "permanentSeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "seatKey"
      ],
      "properties": {
        "kind": {
          "const": "permanent_seat"
        },
        "seatKey": {
          "$ref": "#/$defs/seatKey"
        }
      }
    },
    "boundedBatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "batchId",
        "memberSeatKeys"
      ],
      "properties": {
        "kind": {
          "const": "bounded_batch"
        },
        "batchId": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9._-]{2,99}$"
        },
        "memberSeatKeys": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/seatKey"
          }
        }
      }
    },
    "ratePolicy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requestsPerMinute",
        "maxConcurrentRequests",
        "minDelayMs",
        "maxRetries",
        "backoffSeconds",
        "robotsPolicy"
      ],
      "properties": {
        "requestsPerMinute": {
          "type": "integer",
          "minimum": 1,
          "maximum": 60
        },
        "maxConcurrentRequests": {
          "type": "integer",
          "minimum": 1,
          "maximum": 8
        },
        "minDelayMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60000
        },
        "maxRetries": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "backoffSeconds": {
          "type": "integer",
          "minimum": 0,
          "maximum": 3600
        },
        "robotsPolicy": {
          "type": "string",
          "enum": [
            "honor",
            "not_applicable_with_documented_reason"
          ]
        }
      }
    },
    "output": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "namespace",
        "writeMode",
        "visibility"
      ],
      "properties": {
        "namespace": {
          "type": "string",
          "pattern": "^data/(sources|staging|research-staging|operations)/[a-z0-9][a-z0-9._/-]*$"
        },
        "writeMode": {
          "enum": [
            "append_only",
            "idempotent_upsert"
          ]
        },
        "visibility": {
          "const": "review_only"
        }
      }
    }
  }
}
