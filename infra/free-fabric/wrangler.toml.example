name = "civiclenz-free-fabric"
main = "src/index.ts"
compatibility_date = "2026-07-16"
workers_dev = true

[triggers]
crons = ["*/5 * * * *"]

[[d1_databases]]
binding = "DB"
database_name = "civiclenz-control"
database_id = "REPLACE_WITH_D1_DATABASE_ID"

[vars]
DEFAULT_LEASE_SECONDS = "900"
MAX_CLAIM_BATCH = "20"

# Set the API secret separately. Never commit it:
# npx wrangler secret put CONTROL_TOKEN
