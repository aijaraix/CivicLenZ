# Copy to .env.local for local development. Never commit real credentials.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Supabase: public values may be used by the browser; service role is server-only.
# The Next.js website must use the anon key only. Collection Workers read
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY from Cloudflare secrets, not from
# this file or NEXT_PUBLIC_* variables.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email: server-only.
RESEND_API_KEY=
RESEND_FROM_ACCOUNTS="CivicLenZ Accounts <accounts@civicslenz.com>"
RESEND_FROM_UPDATES="CivicLenZ Updates <updates@civicslenz.com>"

# Optional operational tools.
SENTRY_DSN=
